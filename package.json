{
  "name": "obsidian-pm-board",
  "version": "0.6.8",
  "description": "Project management board views for Obsidian Bases",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -p tsconfig.json && node esbuild.config.mjs production",
    "test": "vitest run --dir tests",
    "lint": "tsc -noEmit -p tsconfig.json && tsc -noEmit -p tsconfig.tests.json && eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "bases",
    "kanban",
    "board",
    "swimlanes",
    "project-management"
  ],
  "author": "Yurimochi",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "builtin-modules": "5.0.0",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-obsidianmd": "0.4.1",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.8.0",
    "obsidian": "1.13.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "fractional-indexing": "4.0.0"
  }
}
